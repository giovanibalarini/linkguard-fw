#!/bin/sh
set -e

case "$1" in
  remove)
    # Only on actual removal: stop and disable the service.
    if command -v systemctl >/dev/null 2>&1; then
      systemctl stop linkguard-fw 2>/dev/null || true
      systemctl disable linkguard-fw 2>/dev/null || true
    fi
    ;;
  upgrade)
    # On upgrade do NOT disable: the binary is replaced in place and postinst
    # restarts the service (if enabled), so it keeps running and stays enabled.
    :
    ;;
esac
