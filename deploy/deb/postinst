#!/bin/sh
set -e

CONFIG_DIR="/etc/linkguard-fw"
DATA_DIR="/var/lib/linkguard-fw"
CONFIG_FILE="${CONFIG_DIR}/config.json"

case "$1" in
  configure)
    install -d -m 0750 "${DATA_DIR}"
    install -d -m 0750 "${CONFIG_DIR}"

    # /etc/nftables.conf tem que existir ANTES de o serviço subir. Ele está em
    # ReadWritePaths= na unidade systemd SEM o prefixo `-`, e um caminho
    # inexistente ali faz a montagem do namespace falhar: a unidade morre com
    # 226/NAMESPACE e fica em loop de restart, sem nunca chegar a rodar uma
    # linha do binário. Até aqui o arquivo vinha de graça porque o pacote
    # nftables era Depends:; agora a base está em Recommends: (para que
    # `dpkg -i` numa máquina pelada instale E configure — ver o alvo `deb` no
    # Makefile), então numa máquina pelada ele não existe. Sem esta linha, o
    # serviço que deveria instalar o nftables sozinho nunca sobe para fazê-lo.
    #
    # Criar vazio é seguro: o LinkGuard é dono deste arquivo (ver README) e o
    # reescreve por inteiro no primeiro Persist(). O `nft -f` nele é só o
    # cabeçalho que o próprio Persist() gera.
    if [ ! -f /etc/nftables.conf ]; then
      printf '#!/usr/sbin/nft -f\n\n# Arquivo gerenciado pelo LinkGuard FW.\n# Vazio até o primeiro apply de firewall.\n' > /etc/nftables.conf
      chmod 0644 /etc/nftables.conf
      echo "[INFO] /etc/nftables.conf criado (vazio) para o serviço poder subir."
    fi

    # /etc/kea e /etc/unbound/unbound.conf.d têm que existir ANTES de o
    # serviço subir — mesmo numa máquina onde o kea e o unbound ainda não
    # estão instalados.
    #
    # Motivo (medido na VM de teste, não deduzido): a unidade roda com
    # ProtectSystem=strict e o systemd monta o namespace do serviço no
    # START. Um diretório que não existia naquele instante não entra como
    # gravável — o `-` do ReadWritePaths só evita que a unidade morra com
    # 226/NAMESPACE, ele não cria montagem nenhuma. Resultado: o LinkGuard
    # instala o kea sob demanda quando o admin liga o DHCP, o apt cria o
    # /etc/kea de verdade, e o processo em execução continua vendo aquele
    # diretório como somente-leitura ("Read-only file system") até alguém
    # reiniciar o serviço. Criando aqui, vazio, a montagem existe desde o
    # start e a primeira aplicação de DHCP/DNS funciona sem reinício.
    #
    # Mesma lógica do /etc/nftables.conf acima. Só cria se não existir: num
    # box que já tem os pacotes, o dono e o modo do diretório são do pacote
    # e não têm que ser mexidos aqui.
    for d in /etc/kea /etc/unbound/unbound.conf.d; do
      if [ ! -d "$d" ]; then
        install -d -m 0755 "$d"
        echo "[INFO] $d criado (vazio) para o LinkGuard poder aplicar DHCP/DNS sem reiniciar."
      fi
    done

    if [ ! -f "${CONFIG_FILE}" ]; then
      # Generate a random JWT secret (64 hex chars) so the service is not
      # accidentally started with an empty/insecure secret.
      JWT_SECRET=$(tr -dc 'a-zA-Z0-9' < /dev/urandom | head -c 64 || true)
      if [ -z "${JWT_SECRET}" ]; then
        JWT_SECRET=$(openssl rand -hex 32 2>/dev/null || date +%s%N | sha256sum | head -c 64)
      fi

      cat > "${CONFIG_FILE}" <<CONFIG
{
  "listen_addr": "127.0.0.1",
  "port": 9997,
  "db_path": "/var/lib/linkguard-fw/linkguard.db",
  "jwt_secret": "${JWT_SECRET}",
  "dry_run": false,
  "debug": false,
  "monitor_interval_seconds": 30,
  "failover_enabled": true,
  "failover_threshold": 3,
  "recovery_threshold": 2,
  "failover_cooldown_seconds": 60,
  "metrics_enabled": true
}
CONFIG
      chmod 640 "${CONFIG_FILE}"
      echo "[INFO] Default config created at ${CONFIG_FILE}"
      echo "[INFO] listen_addr is set to 127.0.0.1 (localhost only)."
      echo "[INFO]   Change to 0.0.0.0 or a specific IP for remote access."
    fi

    if command -v systemctl >/dev/null 2>&1; then
      systemctl daemon-reload
      # On upgrade, restart the service if it is enabled so it picks up the new
      # binary without manual intervention (and stays running). On a fresh
      # install it is not enabled yet, so this is a no-op.
      if systemctl is-enabled --quiet linkguard-fw 2>/dev/null; then
        systemctl restart linkguard-fw 2>/dev/null || true
      fi
    fi

    echo "[INFO] LinkGuard FW installed."
    echo "[INFO] Edit ${CONFIG_FILE} then run: systemctl enable --now linkguard-fw"
    ;;
esac
