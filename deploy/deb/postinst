#!/bin/sh
set -e

CONFIG_DIR="/etc/linkguard-fw"
DATA_DIR="/var/lib/linkguard-fw"
CONFIG_FILE="${CONFIG_DIR}/config.json"

case "$1" in
  configure)
    # Preparo do sistema de arquivos: os caminhos que a unidade declara em
    # ReadWritePaths= têm que existir ANTES de o serviço subir. O systemd
    # monta o namespace no START; um caminho ausente ali ou mata a unidade
    # com 226/NAMESPACE (entradas sem o prefixo `-`) ou fica permanentemente
    # somente-leitura para o processo em execução, mesmo depois de o apt
    # criar o diretório de verdade.
    #
    # A lista mora num lugar só — internal/sysprep, no próprio binário — e é
    # chamada igual pelos três caminhos de instalação (este postinst,
    # deploy/install.sh e `make install`). Antes disso ela existia só aqui, e
    # quem instalava pelos outros dois ficava com o serviço em loop de
    # 226/NAMESPACE. O binário já está desempacotado quando o postinst roda.
    #
    # O que este postinst NÃO cria é o /etc/nftables.conf: ele é conffile do
    # pacote `nftables`, e criá-lo aqui — dentro da transação do dpkg, que é
    # livre para desempacotar o `nftables` DEPOIS, já que a base fica em
    # Recommends: — fazia `apt install ./linkguard-fw_*.deb` numa máquina
    # pelada parar no prompt de conffile do dpkg, com o `nftables` em `iU`.
    # Quem o cria é o ExecStartPre da unidade, fora do apt. Ver
    # internal/sysprep, tipo Stage.
    #
    # Não aborta a configuração do pacote em caso de falha: um pacote em `iU`
    # não deixa painel nenhum para explicar o que houve, que é justamente o
    # que este produto evita.
    if [ -x /usr/local/bin/linkguard-fw ]; then
      /usr/local/bin/linkguard-fw --prepare-system || \
        echo "[WARN] --prepare-system falhou; o serviço pode não subir (veja o erro acima)."
    else
      echo "[WARN] /usr/local/bin/linkguard-fw não encontrado; --prepare-system não rodou."
    fi

    if [ ! -f "${CONFIG_FILE}" ]; then
      # Generate a random JWT secret (64 hex chars) so the service is not
      # accidentally started with an empty/insecure secret.
      JWT_SECRET=$(tr -dc 'a-zA-Z0-9' < /dev/urandom | head -c 64 || true)
      if [ -z "${JWT_SECRET}" ]; then
        JWT_SECRET=$(openssl rand -hex 32 2>/dev/null || date +%s%N | sha256sum | head -c 64)
      fi

      cat > "${CONFIG_FILE}" <<CONFIG
{
  "listen_addr": "127.0.0.1",
  "port": 9997,
  "db_path": "/var/lib/linkguard-fw/linkguard.db",
  "jwt_secret": "${JWT_SECRET}",
  "dry_run": false,
  "debug": false,
  "monitor_interval_seconds": 30,
  "failover_enabled": true,
  "failover_threshold": 3,
  "recovery_threshold": 2,
  "failover_cooldown_seconds": 60,
  "metrics_enabled": true
}
CONFIG
      chmod 640 "${CONFIG_FILE}"
      echo "[INFO] Default config created at ${CONFIG_FILE}"
      echo "[INFO] listen_addr is set to 127.0.0.1 (localhost only)."
      echo "[INFO]   Change to 0.0.0.0 or a specific IP for remote access."
    fi

    if command -v systemctl >/dev/null 2>&1; then
      systemctl daemon-reload
      # On upgrade, restart the service if it is enabled so it picks up the new
      # binary without manual intervention (and stays running). On a fresh
      # install it is not enabled yet, so this is a no-op.
      if systemctl is-enabled --quiet linkguard-fw 2>/dev/null; then
        systemctl restart linkguard-fw 2>/dev/null || true
      fi
    fi

    echo "[INFO] LinkGuard FW installed."
    echo "[INFO] Edit ${CONFIG_FILE} then run: systemctl enable --now linkguard-fw"
    ;;
esac
