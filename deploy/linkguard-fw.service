[Unit]
Description=LinkGuard FW - Linux Firewall Management Tool
Documentation=https://github.com/giovanibalarini/linkguard-fw
After=network.target
Wants=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/linkguard-fw --config /etc/linkguard-fw/config.json
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

# Run as root (required for iptables / ip route)
User=root
Group=root

# Working directory
WorkingDirectory=/var/lib/linkguard-fw

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=linkguard-fw

# Security hardening (compatible with iptables/iproute2 access)
NoNewPrivileges=yes
ProtectSystem=strict
# Writable paths so the app can persist generated configs: nftables (firewall),
# Kea (DHCP), unbound (DNS) and the conntrack-accounting sysctl drop-in.
ReadWritePaths=/var/lib/linkguard-fw /etc/linkguard-fw /etc/nftables.conf /etc/kea /etc/unbound /etc/sysctl.d
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
