[Unit]
Description=LinkGuard FW - Linux Firewall Management Tool
Documentation=https://github.com/giovanibalarini/linkguard-fw
After=network.target
Wants=network.target
OnFailure=linkguard-notify-down.service

[Service]
Type=simple
# Cria os caminhos que um INSTALADOR não pode criar, porque criá-los de
# dentro de uma transação do dpkg trava a instalação: /etc/nftables.conf é
# conffile do pacote `nftables`, e com ele já no disco o dpkg para para
# perguntar a quem obedecer quando desempacota o `nftables`
# ("*** nftables.conf (Y/I/N/O/D/Z) [default=N] ?" — e, sem tty, "end of file
# on stdin at conffile prompt", com o pacote parando em `iU`). Aqui já
# estamos fora do apt.
#
# Os dois prefixos são obrigatórios, e a semântica foi MEDIDA (systemd 257,
# Debian 13), não presumida:
#
#   `+`  tira o comando do ProtectSystem=strict. Sem ele o pre-comando
#        recebe "cannot create /etc/nftables.conf: Read-only file system".
#        O que o `+` NÃO faz é pular a montagem do namespace: com
#        /etc/nftables.conf listado SEM o `-` em ReadWritePaths=, o próprio
#        ExecStartPre=+ morre em 226/NAMESPACE antes de criar o arquivo.
#        Por isso a entrada abaixo ganhou o prefixo `-`.
#   `-`  torna a falha não fatal: se o preparo não puder ser feito, o
#        LinkGuard ainda sobe e o painel explica o problema no apply (ver
#        sysprep.SandboxHint) — em vez de a máquina ficar sem painel nenhum.
#
# E o que faz isto funcionar: o namespace de montagem é construído UMA VEZ
# POR COMANDO. O ExecStart monta o dele depois deste pre-comando, então o
# arquivo recém-criado já existe e entra no namespace como gravável.
ExecStartPre=-+/usr/local/bin/linkguard-fw --prepare-system-at-start
ExecStart=/usr/local/bin/linkguard-fw --config /etc/linkguard-fw/config.json
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

# Run as root (required for iptables / ip route)
User=root
Group=root

# Working directory
WorkingDirectory=/var/lib/linkguard-fw

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=linkguard-fw

# Security hardening (compatible with iptables/iproute2 access)
NoNewPrivileges=yes
ProtectSystem=strict
# Writable paths so the app can persist generated configs: nftables (firewall),
# Kea (DHCP), unbound (DNS), the conntrack-accounting sysctl drop-in, the
# stable-interface-name .link files (Fase A: nomes estáveis por MAC), the
# NTP (chrony) drop-in, and the resolver/dhclient files that keep DNS pointed
# at the local unbound.
#
# Paths whose owning package is only Recommends: (or, for /etc/dhcp, not
# depended on at all) are prefixed with `-`: per systemd.exec(5), an
# unprefixed ReadWritePaths= entry that does not exist at start fails
# namespace setup and the unit dies with 226/NAMESPACE. /etc/dhcp comes from
# isc-dhcp-client, which this package neither Depends: nor Recommends: — a
# box with only a static WAN, or Debian 13 (where isc-dhcp is deprecated),
# would otherwise never be able to start the firewall manager at all.
# ATENÇÃO ao que o `-` NÃO faz: ele só torna o caminho opcional na subida da
# unidade. O namespace é montado no START do serviço, então um diretório que
# não existia naquele instante não vira gravável só porque o apt o criou
# depois — o processo em execução continua vendo "Read-only file system".
# Por isso os diretórios de config dos pacotes opcionais (/etc/kea,
# /etc/unbound/unbound.conf.d, /etc/chrony/conf.d) são criados vazios pelo
# instalador: é o que permite instalar kea/unbound/chrony sob demanda (quando
# o admin liga o DHCP/DNS/NTP no painel) e aplicar a config na MESMA
# execução, sem reiniciar o serviço no meio de uma ação do admin.
#
# QUEM cria: `linkguard-fw --prepare-system`, chamado pelos TRÊS caminhos de
# instalação (postinst do .deb, deploy/install.sh e `make install`), mais o
# `--prepare-system-at-start` do ExecStartPre acima, para o que os
# instaladores não podem tocar. A lista está em internal/sysprep e cobre
# /var/lib/linkguard-fw, /etc/linkguard-fw, /etc/nftables.conf, /etc/sysctl.d,
# /etc/kea, /etc/unbound/unbound.conf.d e /etc/chrony/conf.d. Os testes de
# empacotamento (internal/sysprep) exigem que TODA entrada sem o prefixo `-`
# desta linha esteja nessa lista.
#
# /etc/sysctl.d fica sem prefixo porque o instalador o garante. Antes disso
# ele vinha do pacote procps; com a base em Recommends: (para que `dpkg -i`
# numa máquina pelada configure o pacote e o serviço suba), ele não é mais
# garantido por dependência. Sem essa rede de segurança a unidade morre com
# 226/NAMESPACE em loop de restart e nunca chega ao código que instala o
# nftables.
#
# /etc/nftables.conf é a exceção que o `-` acima explica: ele é conffile do
# pacote `nftables`, então NENHUM instalador pode criá-lo (o dpkg pararia num
# prompt de conffile no meio do `apt install`). Quem o cria é o
# ExecStartPre=-+ desta unidade, fora da transação do apt — e é exatamente
# por causa desse pre-comando que a entrada precisa do `-`: sem ele, o
# pre-comando morre em 226/NAMESPACE antes de criar o arquivo (medido).
#
# Os três caminhos com `-` que o LinkGuard NÃO cria são deliberados:
# /etc/systemd/network (do pacote systemd, sempre presente),
# /etc/resolv.conf (sempre presente) e /etc/dhcp (do isc-dhcp-client, que
# este pacote não declara em lugar nenhum — num box só com WAN estática, ou
# no Debian 13, ele legitimamente não existe).
ReadWritePaths=/var/lib/linkguard-fw /etc/linkguard-fw /etc/sysctl.d -/etc/nftables.conf -/etc/kea -/etc/unbound -/etc/systemd/network -/etc/chrony/conf.d -/etc/resolv.conf -/etc/dhcp
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
