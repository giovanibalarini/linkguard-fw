[Unit]
Description=LinkGuard FW - Linux Firewall Management Tool
Documentation=https://github.com/giovanibalarini/linkguard-fw
After=network.target
Wants=network.target
OnFailure=linkguard-notify-down.service

[Service]
Type=simple
ExecStart=/usr/local/bin/linkguard-fw --config /etc/linkguard-fw/config.json
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

# Run as root (required for iptables / ip route)
User=root
Group=root

# Working directory
WorkingDirectory=/var/lib/linkguard-fw

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=linkguard-fw

# Security hardening (compatible with iptables/iproute2 access)
NoNewPrivileges=yes
ProtectSystem=strict
# Writable paths so the app can persist generated configs: nftables (firewall),
# Kea (DHCP), unbound (DNS), the conntrack-accounting sysctl drop-in, the
# stable-interface-name .link files (Fase A: nomes estáveis por MAC), the
# NTP (chrony) drop-in, and the resolver/dhclient files that keep DNS pointed
# at the local unbound.
#
# Paths whose owning package is only Recommends: (or, for /etc/dhcp, not
# depended on at all) are prefixed with `-`: per systemd.exec(5), an
# unprefixed ReadWritePaths= entry that does not exist at start fails
# namespace setup and the unit dies with 226/NAMESPACE. /etc/dhcp comes from
# isc-dhcp-client, which this package neither Depends: nor Recommends: — a
# box with only a static WAN, or Debian 13 (where isc-dhcp is deprecated),
# would otherwise never be able to start the firewall manager at all.
# ATENÇÃO ao que o `-` NÃO faz: ele só torna o caminho opcional na subida da
# unidade. O namespace é montado no START do serviço, então um diretório que
# não existia naquele instante não vira gravável só porque o apt o criou
# depois — o processo em execução continua vendo "Read-only file system".
# Por isso o postinst cria /etc/kea e /etc/unbound/unbound.conf.d vazios: é o
# que permite instalar o kea/unbound sob demanda (quando o admin liga o
# DHCP/DNS no painel) e aplicar a config na MESMA execução, sem reiniciar o
# serviço no meio de uma ação do admin.
#
# /var/lib/linkguard-fw, /etc/linkguard-fw, /etc/nftables.conf and
# /etc/sysctl.d are always present (created by this package's own postinst)
# and stay unprefixed. /etc/nftables.conf is only "always present" BECAUSE
# the postinst creates it when missing: since the base packages moved from
# Depends: to Recommends: (so `dpkg -i` on a bare machine configures the
# package and the service can start), the nftables package — which is what
# used to ship that file — may not be installed yet on a first boot. Without
# that safety net the unit dies with 226/NAMESPACE in a restart loop and
# never reaches the code that installs nftables.
ReadWritePaths=/var/lib/linkguard-fw /etc/linkguard-fw /etc/nftables.conf /etc/sysctl.d -/etc/kea -/etc/unbound -/etc/systemd/network -/etc/chrony/conf.d -/etc/resolv.conf -/etc/dhcp
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
